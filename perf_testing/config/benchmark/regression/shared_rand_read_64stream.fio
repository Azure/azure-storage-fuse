[global]
ioengine=sync
rw=randread
bs=1M
size=128G
numjobs=64
filename=max-read.0:max-read.1:max-read.2:max-read.3:max-read.4:max-read.5:max-read.6:max-read.7:max-read.8:max-read.9:max-read.10:max-read.11:max-read.12:max-read.13:max-read.14:max-read.15
direct=1
allow_file_create=0
invalidate=1
runtime=30s
time_based=1
ramp_time=5s
randrepeat=1
group_reporting=1
lat_percentiles=1
percentile_list=50:95:99:99.9

[shared-set-random-read-64-stream]
