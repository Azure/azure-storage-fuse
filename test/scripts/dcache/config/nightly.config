# Shared configuration for the distributed_cache nightly E2E scripts.
#
# Cluster settings may be overridden via environment variables using the
# ${VAR:-default} pattern. DACS artifacts are pinned to one public release.
#
# The cluster substrate is kind (Kubernetes IN Docker).

CLUSTER_NAME="${CLUSTER_NAME:-blobfuse-dcache}"
NAMESPACE="${NAMESPACE:-cache-server}"
RELEASE_NAME="${RELEASE_NAME:-dacs}"

# Kind cluster shape. KIND_NODES is a *total* count (control-plane + workers),
# kept at 4 for three DACS cache servers on separate workers.
KIND_NODES="${KIND_NODES:-4}"
KIND_VERSION="${KIND_VERSION:-v0.32.0}"
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.36.1}"

CACHE_SERVER_PORT="${CACHE_SERVER_PORT:-9065}"
CACHE_SERVER_REPLICAS="${CACHE_SERVER_REPLICAS:-3}"

# The pinned chart supplies the MCR image repositories and matching image tags.
DACS_CHART_REF="oci://mcr.microsoft.com/dacs/helmchart/dacs"
DACS_CHART_VERSION="0.1.0-alpha.2"
